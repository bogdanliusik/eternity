# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# PostgreSQL
POSTGRES_DB=eternitydb
POSTGRES_USER=postgres
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# JWT — generate: openssl rand -base64 64
JWT_SECRET_KEY=

# Admin seed user
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@eternity.com
# Generate: openssl rand -base64 24
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FULLNAME=Administrator

# Cookie security
COOKIE_SAME_SITE=Strict
COOKIE_SECURE_POLICY=Always

# CORS — additional origins (optional, e.g. for local dev)
#CORS_ADDITIONAL_ORIGIN_1=http://localhost:18080
#CORS_ADDITIONAL_ORIGIN_2=

ASPNETCORE_ENVIRONMENT=Production
