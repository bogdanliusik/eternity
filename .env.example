# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# PostgreSQL Configuration
POSTGRES_DB=eternitydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe_SecurePassword123!

# JWT Configuration (REQUIRED)
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=REPLACE_WITH_SECURE_KEY_AT_LEAST_64_CHARACTERS_LONG

# Admin Seed (REQUIRED)
# Credentials for the initial admin user created on first startup.
# Password is reset to this value on every startup.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@eternity.com
ADMIN_SEED_PASSWORD=ChangeMe_AdminPassword123!
ADMIN_SEED_FULLNAME=Administrator

# Cookie Configuration
COOKIE_SAME_SITE=Strict
COOKIE_SECURE_POLICY=SameAsRequest

# CORS — Additional allowed origins (optional, for local testing)
# Production origins (eternity.liusik.com) are always included.
# Set these to add extra origins, e.g. http://localhost:18080
#CORS_ADDITIONAL_ORIGIN_1=http://localhost:18080
#CORS_ADDITIONAL_ORIGIN_2=

# ASP.NET Environment
ASPNETCORE_ENVIRONMENT=Production

# PgAdmin (Optional - for development)
PGADMIN_EMAIL=admin@eternity.local
PGADMIN_PASSWORD=admin123
