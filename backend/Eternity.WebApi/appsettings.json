{
  "ConnectionStrings": {
    "EternityDb": "REPLACE_WITH_ENVIRONMENT_VARIABLE"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_ENVIRONMENT_VARIABLE",
    "AccessTokenExpirationSeconds": 3600,
    "RefreshTokenExpirationMinutes": 2880,
    "Issuer": "EternityAPI",
    "Audience": "EternityClient"
  },
  "CookieSettings": {
    "AccessTokenCookieName": "eternity_access_token",
    "SessionIdCookieName": "eternity_session_id",
    "SameSiteMode": "Strict",
    "SecurePolicy": "SameAsRequest"
  },
  "CorsSettings": {
    "AllowedOrigins": []
  },
  "AdminSeed": {
    "Username": "",
    "FullName": "",
    "Email": "",
    "Password": ""
  },
  "SessionCleanup": {
    "IntervalMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection.KeyManagement.XmlKeyManager": "Error"
    }
  },
  "MediatR": {
    "LicenseKey": ""
  },
  "AllowedHosts": "*"
}