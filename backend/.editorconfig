# Editor configuration for the backend .NET solution.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120

# Rider/ReSharper-specific rules. Keep them conservative, but still prefer
# readable continuation indentation for wrapped invocations while avoiding
# aggressive custom wrapping/alignment styles.
resharper_csharp_keep_user_linebreaks = true
resharper_csharp_keep_existing_linebreaks = true
resharper_csharp_continuous_indent_multiplier = 1
resharper_csharp_use_continuous_indent_inside_parens = false
resharper_csharp_use_continuous_indent_inside_initializer_braces = false
resharper_csharp_indent_invocation_pars = inside
resharper_csharp_indent_anonymous_method_block = false
resharper_csharp_align_multiline_argument = false
resharper_csharp_align_first_arg_by_paren = false
resharper_csharp_align_multiline_array_and_object_initializer = false
resharper_csharp_align_multiline_calls_chain = false
resharper_csharp_keep_blank_lines_in_declarations = 0
resharper_csharp_keep_blank_lines_in_code = 0
resharper_csharp_remove_blank_lines_near_braces_in_declarations = true
resharper_csharp_remove_blank_lines_near_braces_in_code = true
resharper_csharp_blank_lines_before_control_transfer_statements = 0
resharper_csharp_blank_lines_after_control_transfer_statements = 0
resharper_csharp_blank_lines_before_block_statements = 0
resharper_csharp_blank_lines_after_block_statements = 0
resharper_csharp_blank_lines_before_multiline_statements = 0
resharper_csharp_blank_lines_after_multiline_statements = 0
resharper_csharp_blank_lines_around_invocable = 1
resharper_csharp_blank_lines_around_property = 0
resharper_csharp_blank_lines_around_single_line_property = 0
resharper_csharp_blank_lines_around_auto_property = 0
resharper_csharp_blank_lines_around_single_line_auto_property = 0
resharper_csharp_braces_for_ifelse = required
resharper_csharp_braces_for_for = required
resharper_csharp_braces_for_foreach = required
resharper_csharp_braces_for_while = required
resharper_csharp_braces_for_dowhile = required
resharper_csharp_braces_for_using = required
resharper_csharp_braces_for_lock = required
resharper_csharp_braces_for_fixed = required
resharper_csharp_braces_redundant = false
resharper_csharp_place_simple_embedded_statement_on_same_line = false
resharper_csharp_place_simple_embedded_block_on_same_line = false
resharper_csharp_null_checking_pattern_style = not_null_pattern
resharper_csharp_wrap_before_dot_in_method_calls = true
resharper_csharp_wrap_chained_method_calls = chop_if_long
resharper_csharp_wrap_after_dot_in_method_calls = false
resharper_csharp_indent_method_decl_pars = inside
resharper_csharp_place_simple_initializer_on_single_line = true
resharper_csharp_place_simple_anonymousmethod_on_single_line = false
resharper_csharp_keep_existing_initializer_arrangement = true
resharper_csharp_wrap_object_and_collection_initializer_style = do_not_change

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

csharp_style_namespace_declarations = file_scoped
csharp_using_directive_placement = outside_namespace

# Match the prevailing handwritten backend style:
# type braces on a new line, method/control braces on the same line.
csharp_new_line_before_open_brace = types
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true
csharp_style_prefer_extended_property_pattern = true:suggestion

dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0161.severity = warning

# Practical analyzer baseline for the current architecture.
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1848.severity = none

[Eternity.Infrastructure/Migrations/*.cs]
generated_code = true
csharp_style_namespace_declarations = block_scoped
csharp_new_line_before_open_brace = all
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0055.severity = none
dotnet_diagnostic.IDE0161.severity = none

[Eternity.Infrastructure/Migrations/*.Designer.cs]
generated_code = true

[Eternity.Infrastructure/Migrations/AppDbContextModelSnapshot.cs]
generated_code = true
